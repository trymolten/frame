# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL="postgresql://USER@localhost:5432/frame?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/frame?schema=public"
# Max connections per app instance (put PgBouncer in front when scaling out).
# DATABASE_POOL_MAX=10

# App: the public URL, used for canonical links, social images and server-side
# tRPC calls. In production set it to the live domain, e.g. https://trymolten.ai
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Inngest — local dev server: npx inngest-cli@1.53.0 dev -u http://localhost:3000/api/inngest
INNGEST_DEV=1
# Production: INNGEST_EVENT_KEY= and INNGEST_SIGNING_KEY=

# AI agent (required for code generation, with either sandbox provider)
OPENAI_API_KEY=
# Any OpenAI-compatible API instead, e.g. a local Ollama (no key needed).
# The Inngest server calls it: use localhost when Inngest runs on the host,
# host.docker.internal under docker compose. OPENAI_MODEL sets every agent's
# model and must return structured tool calls. OPENAI_REASONING_EFFORT is sent
# as reasoning_effort; qwen3 on Ollama needs "none" to call tools.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen3:8b
# OPENAI_REASONING_EFFORT=none

# Code sandbox the agent builds apps in: "docker" (local containers, no
# account needed) or "e2b" (E2B cloud). Unset: e2b if E2B_API_KEY is set,
# otherwise docker. Docker needs the image from scripts/sandbox/build-image.sh
# (docker compose builds it for you).
# SANDBOX_PROVIDER=docker
E2B_API_KEY=
# Docker provider only: the docker CLI to call, and the host your browser
# uses to reach preview ports (published on 127.0.0.1).
# SANDBOX_DOCKER_BIN=docker
# SANDBOX_PREVIEW_HOST=localhost

# docker compose host ports, if the defaults are taken.
# APP_PORT=3000
# INNGEST_PORT=8288
# POSTGRES_PORT=5432
