# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL="postgresql://USER@localhost:5432/frame?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/frame?schema=public"
# Max connections per app instance (put PgBouncer in front when scaling out).
# DATABASE_POOL_MAX=10

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Inngest — local dev server: npx inngest-cli@1.53.0 dev -u http://localhost:3000/api/inngest
INNGEST_DEV=1
# Production: INNGEST_EVENT_KEY= and INNGEST_SIGNING_KEY=

# AI agent + sandbox (required for code generation)
OPENAI_API_KEY=
E2B_API_KEY=
