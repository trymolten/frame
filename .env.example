# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL="postgresql://USER@localhost:5432/molten?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/molten?schema=public"
# Max connections per app instance (put PgBouncer in front when scaling out).
# DATABASE_POOL_MAX=10

# App: the public URL, used for canonical links, social images and server-side
# tRPC calls. In production set it to the live domain, e.g. https://trymolten.ai
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Inngest — local dev server: npx inngest-cli@1.53.0 dev -u http://localhost:3000/api/inngest
INNGEST_DEV=1
# Production: INNGEST_EVENT_KEY= and INNGEST_SIGNING_KEY=

# Code agent model: "ollama" (a local model, no key) or "openai". Unset:
# openai if OPENAI_API_KEY is set, otherwise ollama. Ollama needs the Ollama
# app running; `make up` pulls OLLAMA_MODEL if it's missing.
# AI_PROVIDER=ollama
OPENAI_API_KEY=
# OLLAMA_MODEL=qwen3:8b
# docker compose sets this to host.docker.internal for you.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Code sandbox the agent builds apps in: "docker" (local containers, no
# account needed) or "e2b" (E2B cloud). Unset: e2b if E2B_API_KEY is set,
# otherwise docker. Docker needs the image from scripts/sandbox/build-image.sh
# (docker compose builds it for you).
# SANDBOX_PROVIDER=docker
E2B_API_KEY=
# E2B provider only: the template to start, by name or id. Defaults to the
# template_id in sandbox/nextjs/e2b.toml.
# E2B_TEMPLATE=molten-nextjs-template
# Docker provider only: the docker CLI to call, and the host your browser
# uses to reach preview ports (published on 127.0.0.1).
# SANDBOX_DOCKER_BIN=docker
# SANDBOX_PREVIEW_HOST=localhost

# docker compose host ports, if the defaults are taken.
# APP_PORT=3000
# INNGEST_PORT=8288
# POSTGRES_PORT=5432
