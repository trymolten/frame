generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  RESULT
  ERROR
}

model Message {
  id      String      @id @default(uuid())
  content String
  role    MessageRole
  type    MessageType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fragment Fragment?

  @@index([projectId, createdAt])
}

model Fragment {
  id         String @id @default(uuid())
  title      String
  sandboxUrl String
  files      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum ProjectStatus {
  IDLE
  GENERATING
  READY
  FAILED
}

model Project {
  id           String            @id @default(uuid())
  name         String
  description  String?
  userId       String
  starred      Boolean           @default(false)
  visibility   ProjectVisibility @default(PUBLIC)
  status       ProjectStatus     @default(IDLE)
  lastOpenedAt DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, lastOpenedAt(sort: Desc)])
  @@index([userId, starred, updatedAt(sort: Desc)])
}

model Usage {
  key      String    @id
  points   Int
  expire   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
